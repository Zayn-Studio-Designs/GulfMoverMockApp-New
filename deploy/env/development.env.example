# Gulf Mover — development build/runtime variables (TEMPLATE; placeholders only, never real secrets).
# Browser bundle (public values only):
VITE_APP_MODE=demo
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=YOUR-development-PUBLISHABLE-KEY
VITE_AUTH_RESET_REDIRECT_URL=http://127.0.0.1:3000/auth/reset-callback
VITE_PAYMENTS_FUNCTION_URL=
VITE_ERROR_REPORTING_URL=
VITE_RELEASE=
# Environment separation (enforced by the dev server, see src/lib/supabase.ts):
#   the production project ref — the dev server refuses it even with the override below.
VITE_PRODUCTION_PROJECT_REF=YOUR-production-PROJECT-REF
#   set to true ONLY for a hosted development/staging project; a local stack needs nothing.
VITE_ALLOW_REMOTE_DATABASE=
#
# Edge-function secrets — set with `supabase secrets set` on the development project, NEVER here or in VITE_*:
#   SUPABASE_SERVICE_ROLE_KEY, GM_PUBLIC_APP_URL, GM_FUNCTIONS_PUBLIC_URL,
#   GM_SANDBOX_WEBHOOK_SECRET, GM_SANDBOX_CHECKOUT_URL,
#   MOYASAR_TEST_SECRET_KEY, MOYASAR_TEST_WEBHOOK_TOKEN (sandbox) | TAP_TEST_SECRET_KEY,
#   GM_PAYMENTS_LIVE_ENABLED must stay false outside production
#   RESEND_API_KEY + GM_EMAIL_FROM, UNIFONIC_APP_SID + UNIFONIC_SENDER_ID, WHATSAPP_* (when approved)

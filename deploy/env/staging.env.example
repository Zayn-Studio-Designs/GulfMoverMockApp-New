# Gulf Mover — staging build/runtime variables (TEMPLATE; placeholders only, never real secrets).
# Browser bundle (public values only):
VITE_APP_MODE=production
VITE_SUPABASE_URL=https://YOUR-staging-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-staging-PUBLISHABLE-KEY
VITE_AUTH_RESET_REDIRECT_URL=https://YOUR-staging-APP-ORIGIN/auth/reset-callback
VITE_PAYMENTS_FUNCTION_URL=https://YOUR-staging-PROJECT-REF.supabase.co/functions/v1/payments
VITE_ERROR_REPORTING_URL=
VITE_RELEASE=
# Release check (not bundled): lets `npm run check:env` prove which project this build targets.
GM_PRODUCTION_PROJECT_REF=YOUR-production-PROJECT-REF
#
# Edge-function secrets — set with `supabase secrets set` on the staging project, NEVER here or in VITE_*:
#   SUPABASE_SERVICE_ROLE_KEY, GM_PUBLIC_APP_URL, GM_FUNCTIONS_PUBLIC_URL,
#   GM_SANDBOX_WEBHOOK_SECRET, GM_SANDBOX_CHECKOUT_URL,
#   MOYASAR_TEST_SECRET_KEY, MOYASAR_TEST_WEBHOOK_TOKEN (sandbox) | TAP_TEST_SECRET_KEY,
#   GM_PAYMENTS_LIVE_ENABLED must stay false outside production
#   RESEND_API_KEY + GM_EMAIL_FROM, UNIFONIC_APP_SID + UNIFONIC_SENDER_ID, WHATSAPP_* (when approved)

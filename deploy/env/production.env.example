# Gulf Mover — production build/runtime variables (TEMPLATE; placeholders only, never real secrets).
# Browser bundle (public values only):
VITE_APP_MODE=production
VITE_SUPABASE_URL=https://YOUR-production-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-production-PUBLISHABLE-KEY
VITE_AUTH_RESET_REDIRECT_URL=https://YOUR-production-APP-ORIGIN/auth/reset-callback
VITE_PAYMENTS_FUNCTION_URL=https://YOUR-production-PROJECT-REF.supabase.co/functions/v1/payments
VITE_ERROR_REPORTING_URL=
VITE_RELEASE=
#
# Edge-function secrets — set with `supabase secrets set` on the production project, NEVER here or in VITE_*:
#   SUPABASE_SERVICE_ROLE_KEY, GM_PUBLIC_APP_URL, GM_FUNCTIONS_PUBLIC_URL,
#   GM_SANDBOX_WEBHOOK_SECRET, GM_SANDBOX_CHECKOUT_URL,
#   MOYASAR_TEST_SECRET_KEY, MOYASAR_TEST_WEBHOOK_TOKEN (sandbox) | TAP_TEST_SECRET_KEY,
#   GM_PAYMENTS_LIVE_ENABLED=false until ATCO authorises; then MOYASAR_LIVE_* or TAP_LIVE_*
#   RESEND_API_KEY + GM_EMAIL_FROM, UNIFONIC_APP_SID + UNIFONIC_SENDER_ID, WHATSAPP_* (when approved)

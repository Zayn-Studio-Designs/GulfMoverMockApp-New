{
  "name": "gulf-mover-mock-app",
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "presentation": "vite --open /presentation.html",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run src/tests/integration",
    "test:e2e:local": "node scripts/e2e/local-journeys.mjs",
    "test:e2e:signed-in": "node scripts/e2e/phase11-signed-in-routes.mjs",
    "build:release": "vite build && node scripts/release/write-build-info.mjs",
    "test:db": "vitest run --no-file-parallelism src/tests/db",
    "test:db:upgrade": "GM_DB_UPGRADE=1 vitest run src/tests/db/phase8.upgrade.db.test.ts",
    "db:up": "scripts/db/local-db.sh up",
    "db:down": "scripts/db/local-db.sh down",
    "db:backup-drill": "scripts/db/backup-restore-drill.sh",
    "check:env": "node scripts/release/check-env.mjs",
    "test:e2e:real-auth": "node scripts/e2e/phase13-real-auth.mjs",
    "test:e2e:real-browser": "node scripts/e2e/phase13-real-browser.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "@types/react-router-dom": "^5.3.3",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "typescript": "^5.0.0",
    "vite": "^5.2.0",
    "vitest": "^2.1.9"
  }
}
